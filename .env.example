# Set to your backend server URL (without /api suffix)
# When empty/undefined, the app uses mock data
VITE_API_BASE_URL=http://localhost:8000
GOOGLE_MAP_API_KEY=

# -----------------------------------------------------------------------------
# Mapbox (campus map feature)
# -----------------------------------------------------------------------------
# Public Mapbox token (read-only). Get one at https://account.mapbox.com/access-tokens/
# Required scopes: styles:read, fonts:read. Optional: geocoding:read, vision:read.
# Do NOT use a secret (sk.*) token here — secret scopes cannot be granted to
# public tokens, and the app does not need them.
VITE_MAPBOX_TOKEN=

# Mapbox style URL. Swap freely by uncommenting a different line and reloading.
# The active line is what the /map page uses. Try a few to see what looks best
# in your design — no code changes required, just edit and restart the dev server.
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Alternatives — uncomment ONE of these instead of the line above:
#
# Light, minimal style (good if the rest of the app is already colorful):
# VITE_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
#
# Dark theme (only useful once the app has a dark mode toggle):
# VITE_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11
#
# Outdoors style with terrain shading and parks:
# VITE_MAPBOX_STYLE=mapbox://styles/mapbox/outdoors-v12
#
# Modern 3D-capable standard style (no road labels by default — avoid for now):
# VITE_MAPBOX_STYLE=mapbox://styles/mapbox/standard
#
# Once you publish a custom style in Mapbox Studio, paste its URL here:
# VITE_MAPBOX_STYLE=mapbox://styles/<your-username>/<your-style-id>
